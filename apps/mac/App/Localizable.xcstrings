          }
        }
      }
    },
    "%@ (%@) is taken. Podlight tries every 30 seconds until %@ for a card up to %@ and then starts by itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) ist belegt. Podlight versucht es bis %3$@ alle 30 Sekunden mit Karten bis %4$@ und startet dann von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@) is taken. Podlight tries every 30 seconds until %3$@ for a card up to %4$@ and then starts by itself."
          }
        }
      }
    },
    "%@ (this Mac)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (dieser Mac)"
