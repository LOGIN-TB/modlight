    "Stopped at the end you chose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum gewählten Ende gestoppt."
          }
        }
      }
    },
    "Stopped at the maximum runtime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Höchstlaufzeit gestoppt."
          }
        }
      }
    },
    "Stopped at the monthly spending limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Monatslimit gestoppt."
          }
        }
      }
    },
    "Stopped at today's spending limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Tageslimit gestoppt."
          }
        }
      }
    },
    "Stopped because no requests came in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt, weil keine Anfragen kamen."
          }
        }
      }
    },
    "Stopped by you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dir gestoppt."
          }
        }
      }
    },
    "Stopped outside Podlight, most likely by its own safety stop (no contact with Podlight, or its end passed).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb von Podlight gestoppt, vermutlich durch die eigene Notbremse (kein Kontakt zu Podlight oder Ende überschritten)."
          }
        }
      }
    },
    "Stopped pods": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppte Pods"
          }
        }
      }
    },
    "Stopped pods keep their disk so the next start skips the download. RunPod charges a few cents per GB and month for it. Podlight deletes pods left unused for %lld days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppte Pods behalten ihre Festplatte, damit der nächste Start ohne Download auskommt. RunPod berechnet dafür wenige Cent pro GB und Monat. Podlight löscht Pods, die %lld Tage unbenutzt waren."
          }
        }
      }
    },
    "Stopped when Podlight quit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Beenden von Podlight gestoppt."
          }
        }
      }
    },
    "Stopped when the schedule window closed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende des Zeitfensters gestoppt."
          }
        }
      }
    },
    "Stopping": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gestoppt"
          }
        }
      }
    },
    "Stops at": {
