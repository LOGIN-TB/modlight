      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur hinzufügen"
          }
        }
      }
    },
    "Add a Hugging Face token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging-Face-Token hinzufügen"
          }
        }
      }
    },
    "Add a model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell hinzufügen"
          }
        }
      }
    },
    "Add a model first": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst ein Modell hinzu"
          }
        }
      }
    },
    "Add a token in Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token in den Einstellungen eintragen"
          }
        }
      }
    },
    "Add and Start…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen und starten …"
          }
        }
      }
    },
    "Add the provider to ~/.codex/config.toml and the function to ~/.zshrc, then start Codex with codex-podlight. Plain codex keeps your normal setup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Anbieter in ~/.codex/config.toml und die Funktion in ~/.zshrc ein und starte Codex dann mit codex-podlight. Der normale Befehl codex bleibt, wie er war."
          }
        }
      }
    },
    "Add your RunPod API key first (Podlight → Settings → Access).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage zuerst deinen RunPod-API-Key ein (Podlight → Einstellungen → Zugänge)."
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse"
          }
        }
      }
    },
