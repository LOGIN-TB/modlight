    "Half the memory, more room for context, and usually faster: measured twice as fast on the same card.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halber Speicher, mehr Platz für Kontext und meist schneller: Auf derselben Karte doppelt so schnell gemessen."
          }
        }
      }
    },
    "Hide": {
      "localizations": {
