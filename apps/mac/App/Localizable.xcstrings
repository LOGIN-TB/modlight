    "Add at the end of the file. Your default provider stays as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende der Datei einfügen. Dein Standardanbieter bleibt, wie er ist."
          }
        }
      }
    },
    "Add the Server's RunPod Key…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunPod-Schlüssel des Servers eintragen …"
          }
        }
      }
    },
    "Add to ~/.zshrc and open a new terminal, then start Codex with %@. Plain codex keeps your normal setup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In ~/.zshrc einfügen, ein neues Terminal öffnen und Codex mit %@ starten. Der normale Befehl codex bleibt, wie er war."
          }
        }
      }
    },
    "Add to ~/.zshrc and open a new terminal; from then on %@ starts Claude Code with Podlight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In ~/.zshrc einfügen und ein neues Terminal öffnen. Danach startet %@ Claude Code mit Podlight."
          }
        }
      }
    },
    "Add your RunPod API key first (Podlight → Settings → Access).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage zuerst deinen RunPod-API-Key ein (Podlight → Einstellungen → Zugänge)."
          }
        }
      }
    },
