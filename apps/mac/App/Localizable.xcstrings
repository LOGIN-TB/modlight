    "%@ was stopped by its safety stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde von der Notbremse gestoppt"
          }
        }
      }
    },
    "%@ was taken; Podlight used %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ war vergeben, Podlight hat %2$@ genommen."
