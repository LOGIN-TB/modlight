            "value": "Noch keine Zugangsschlüssel."
          }
        }
      }
    },
    "No answer: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort: %@"
          }
        }
      }
    },
    "No card at RunPod can hold this model right now. Try a 4-bit build, or allow more regions above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade fasst keine Karte bei RunPod dieses Modell. Versuch eine 4-Bit-Variante oder erlaube oben mehr Regionen."
          }
        }
      }
    },
    "No card can hold this model.": {
      "localizations": {
        "de": {
