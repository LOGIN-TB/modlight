    "On %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@"
          }
        }
      }
    },
    "On the server, as root or a user in the docker group. It fetches the current image, starts the server and shows address and pairing code. Run it again to update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server, als root oder als Benutzer der Gruppe docker. Er lädt das aktuelle Image, startet den Server und zeigt Adresse und Kopplungscode. Ein erneuter Aufruf aktualisiert ihn."
          }
        }
      }
    },
    "On · %@ while stopped": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An · %@ im gestoppten Zustand"
          }
        }
      }
