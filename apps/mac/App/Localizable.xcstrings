          }
        }
      }
    },
    "Use an https:// address. Plain http is allowed only for this Mac and your local network, because the keys would travel unencrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine https://-Adresse. Einfaches http ist nur für diesen Mac und dein lokales Netz erlaubt, weil die Schlüssel sonst unverschlüsselt übertragen würden."
          }
        }
      }
    },
    "Use lowercase letters, digits, dots and dashes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt sind Kleinbuchstaben, Ziffern, Punkte und Bindestriche."
          }
