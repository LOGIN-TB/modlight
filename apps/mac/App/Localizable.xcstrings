          }
        }
      }
    },
    "RunPod placed the pod outside your chosen region, so Podlight deleted it straight away. Try again, or allow more regions under Edit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunPod hat den Pod außerhalb deiner Region angelegt, deshalb hat Podlight ihn sofort gelöscht. Versuch es noch einmal oder erlaube unter „Bearbeiten“ mehr Regionen."
