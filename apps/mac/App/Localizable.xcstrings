      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach"
          }
        }
      }
    },
    "Afterwards, while stopped": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach, solange gestoppt"
          }
        }
