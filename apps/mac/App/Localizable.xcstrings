            "value": "Behaltene Festplatten gestoppter Modelle"
          }
        }
      }
    },
    "Key expires": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Key läuft ab"
          }
        }
      }
