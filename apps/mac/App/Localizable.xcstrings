      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlag"
          }
        }
      }
    },
    "Supported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja"
          }
        }
      }
