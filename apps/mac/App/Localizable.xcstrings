          }
        }
      }
    },
    "Podlight": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight"
          }
        }
      }
    },
    "Podlight %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight %@"
          }
        }
      }
    },
    "Podlight Help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight-Hilfe"
          }
        }
      }
    },
    "Podlight could not be moved (%@). Drag it into Applications in the Finder instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight konnte nicht verschoben werden (%@). Zieh es stattdessen im Finder in den Programme-Ordner."
          }
        }
      }
    },
    "Podlight could not use the keychain: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight konnte den Schlüsselbund nicht verwenden: %@"
          }
        }
      }
    },
    "Podlight gives the coding agent on this Mac, for example OpenCode or Claude Code, language models of your choice, behind one address and one key. You decide where each model runs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight gibt dem Coding-Agenten auf diesem Mac, etwa OpenCode oder Claude Code, Sprachmodelle deiner Wahl, hinter einer Adresse und einem Key. Wo jedes Modell läuft, entscheidest du."
          }
        }
      }
    },
    "Podlight is connected to RunPod": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight ist mit RunPod verbunden"
          }
        }
      }
    },
    "Podlight is connected to RunPod and Venice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight ist mit RunPod und Venice verbunden"
          }
        }
      }
    },
    "Podlight is connected to Venice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight ist mit Venice verbunden"
          }
        }
      }
    },
    "Podlight is running from the disk image or your Downloads folder. In Applications it starts reliably at login and updates itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight läuft aus dem Disk-Image oder deinem Download-Ordner. Im Programme-Ordner startet es zuverlässig bei der Anmeldung und aktualisiert sich selbst."
          }
        }
      }
    },
    "Podlight moves into the Applications folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight wandert in den Programme-Ordner"
          }
        }
      }
    },
    "Podlight on GitHub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight auf GitHub"
          }
        }
      }
    },
    "Podlight on this Mac forgets the server. Models on it keep running under the server's own rules, and the server keeps them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight auf diesem Mac vergisst den Server. Die Modelle dort laufen nach den Regeln des Servers weiter, und der Server behält sie."
          }
        }
      }
    },
    "Podlight tries every 30 seconds until %@ and then resumes the pod with its disk, without downloading the model again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight versucht es bis %@ alle 30 Sekunden und setzt den Pod dann mit seiner Festplatte fort, ohne das Modell neu zu laden."
          }
        }
      }
    },
    "Podlight tries every 30 seconds until %@ for a card up to %@ and then starts by itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlight versucht es bis %1$@ alle 30 Sekunden mit Karten bis %2$@ und startet dann von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Podlight tries every 30 seconds until %1$@ for a card up to %2$@ and then starts by itself."
          }
        }
      }
    },
