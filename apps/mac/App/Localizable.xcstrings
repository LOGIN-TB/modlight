            "state": "translated",
            "value": "Token prüfen und speichern"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Updates suchen …"
          }
        }
      }
    },
