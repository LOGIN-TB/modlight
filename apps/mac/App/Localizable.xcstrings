    },
    "Who may connect": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer sich verbinden darf"
          }
        }
      }
    },
    "Works.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert."
          }
        }
      }
    },
    "Yes, for coding agents": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, für Coding-Agenten"
          }
        }
      }
    },
    "You choose how long it runs when you start it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange er läuft, legst du beim Start fest."
          }
        }
      }
    },
    "You need a RunPod account with some credit. Setting up takes about a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst ein RunPod-Konto mit etwas Guthaben. Die Einrichtung dauert etwa eine Minute."
          }
        }
      }
    },
    "You pick a model, Podlight suggests a GPU and shows the price.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wählst ein Modell, Podlight schlägt eine Karte vor und zeigt den Preis."
