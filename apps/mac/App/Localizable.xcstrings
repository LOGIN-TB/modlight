            "value": "Willkommen bei Podlight"
          }
        }
      }
    },
    "What matters most?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist dir am wichtigsten?"
          }
        }
      }
    },
    "Where": {
      "localizations": {
