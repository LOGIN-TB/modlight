    },
    "Agents use http://127.0.0.1:<port>/v1. After a change, update their configuration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten nutzen http://127.0.0.1:<Port>/v1. Nach einer Änderung musst du ihre Konfiguration anpassen."
          }
        }
      }
    },
    "Agents using the old key stop working until you paste the new one into their configuration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten mit dem alten Schlüssel funktionieren erst wieder, wenn du den neuen in ihre Konfiguration einträgst."
