          }
        }
      }
    },
    "Or: docker-compose.yml": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder: docker-compose.yml"
          }
        }
      }
    },
    "Other computers connect with the address under Connection and the same key. The connection is not encrypted: use this only in networks you trust, not in public Wi-Fi. macOS may ask once whether Podlight may accept incoming connections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Rechner verbinden sich mit der Adresse unter „Verbindung“ und demselben Schlüssel. Die Verbindung ist nicht verschlüsselt: Nutze das nur in Netzen, denen du vertraust, nicht im öffentlichen WLAN. macOS fragt eventuell einmal, ob Podlight eingehende Verbindungen annehmen darf."
          }
        }
      }
    },
