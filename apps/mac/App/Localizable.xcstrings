{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    " · suggested": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · empfohlen"
          }
        }
      }
    },
    "%@ (this Mac)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (dieser Mac)"
          }
        }
      }
    },
    "%@ + %@ storage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + %@ Speicher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ + %2$@ storage"
          }
        }
      }
    },
    "%@ cost about %@ per hour. Once Podlight has quit, agents on this Mac can no longer reach them.\n\nIf you keep them running, each pod stops itself after %lld minutes without Podlight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kosten zusammen etwa %2$@ pro Stunde. Ist Podlight beendet, erreichen Agenten auf diesem Mac sie nicht mehr.\n\nLässt du sie weiterlaufen, stoppt sich jeder Pod nach %3$lld Minuten ohne Kontakt zu Podlight selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ cost about %2$@ per hour. Once Podlight has quit, agents on this Mac can no longer reach them.\n\nIf you keep them running, each pod stops itself after %3$lld minutes without Podlight."
          }
        }
      }
    },
    "%@ downloads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Downloads"
          }
        }
      }
    },
    "%@ for the disk": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ für die Festplatte"
          }
        }
      }
    },
    "%@ has no tool calls, so the agent cannot edit files or run commands with it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann keine Werkzeugaufrufe, der Agent kann damit also keine Dateien bearbeiten und keine Befehle ausführen."
          }
        }
      }
    },
    "%@ is ready": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereit"
          }
        }
      }
    },
    "%@ is set to %@ tokens. These agents send long instructions and need at least 128k, better 200k: choose more context under Edit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf %@ Token eingestellt. Diese Agenten schicken lange Anweisungen mit und brauchen mindestens 128k, besser 200k: Stell unter „Bearbeiten“ mehr Kontext ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is set to %2$@ tokens. These agents send long instructions and need at least 128k, better 200k: choose more context under Edit."
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "noch %@"
          }
        }
      }
    },
    "%@ manages this model now. Take it back to use it on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwaltet dieses Modell jetzt. Hol es zurück, um es auf diesem Mac zu nutzen."
          }
        }
      }
    },
    "%@ moved to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist jetzt auf %@"
