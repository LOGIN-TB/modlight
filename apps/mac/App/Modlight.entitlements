<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      No App Sandbox, written out so it reads as a decision. Modlight is distributed with
      Developer ID, not through the Mac App Store, and it runs a local server for agents on this
      Mac. Unsandboxed, its keychain items need no access group and its gateway needs no
      network.server entitlement. Hardened Runtime is on (project.yml), as notarisation requires.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
